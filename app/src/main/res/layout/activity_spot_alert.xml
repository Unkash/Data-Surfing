<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">

        <!-- Activar alerta -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Activar alerta para este spot"
                        android:textStyle="bold" android:textSize="15sp"/>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchEnabled" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="La app comprobará las condiciones en background y te enviará una notificación cuando se cumplan todos los criterios que actives abajo."
                    android:textSize="12sp" android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Olas -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="🌊 Olas" android:textStyle="bold" android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Filtra por la altura total de la ola y su período. El período indica cuánto tiempo pasa entre ola y ola: a más segundos, más energía y más calidad."
                    android:textSize="12sp" android:textColor="@color/text_secondary"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginEnd="4dp" android:hint="Altura mín (m)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWaveMin" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="numberDecimal"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="4dp" android:hint="Altura máx (m) · 0=sin límite">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWaveMax" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="numberDecimal"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:hint="Período mín (s) · Recomendado: 8s en Málaga">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWavePeriod" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberDecimal"/>
                </com.google.android.material.textfield.TextInputLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="💡 En el Mediterráneo el período rara vez supera los 10-12s. Por debajo de 7s las olas suelen ser desordenadas."
                    android:textSize="11sp" android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Swell -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="↗ Swell" android:textStyle="bold" android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="El swell es oleaje generado por tormentas lejanas. Llega organizado y limpio, con más período que el oleaje local de viento. Es el tipo de ola más deseable para surfear."
                    android:textSize="12sp" android:textColor="@color/text_secondary"
                    android:layout_marginBottom="10dp"/>

                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="Swell mín (m)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSwellMin" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberDecimal"/>
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Filtrar dirección swell" android:textSize="13sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Solo avisa si el swell viene del sector óptimo para este spot"
                            android:textSize="11sp" android:textColor="@color/text_secondary"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSwellDir" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginEnd="4dp" android:hint="Swell dir. mín (°)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSwellDirMin" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="4dp" android:hint="Swell dir. máx (°)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSwellDirMax" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="💡 Los grados indican de dónde viene el swell. 0°=Norte, 90°=Este, 180°=Sur, 270°=Oeste. El valor preconfigurado es el óptimo para este spot según su orientación."
                    android:textSize="11sp" android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Viento -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="💨 Viento" android:textStyle="bold" android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="El viento offshore es el que sopla desde tierra hacia el mar, lo que peina las olas y las deja limpias. El viento onshore (del mar a tierra) las destroza."
                    android:textSize="12sp" android:textColor="@color/text_secondary"
                    android:layout_marginBottom="10dp"/>

                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="Velocidad máx (km/h) · Recomendado: 25-30 km/h">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWindMax" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberDecimal"/>
                </com.google.android.material.textfield.TextInputLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="💡 Aunque el viento sea offshore, si supera los 30-35 km/h puede cerrar las olas. Por encima de 40 km/h raramente es surfeable."
                    android:textSize="11sp" android:textColor="@color/text_secondary"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Filtrar dirección offshore" android:textSize="13sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Solo avisa si el viento sopla desde tierra (offshore) para este spot"
                            android:textSize="11sp" android:textColor="@color/text_secondary"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchWindDir" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginEnd="4dp" android:hint="Offshore mín (°)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etOffshoreMin" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="4dp" android:hint="Offshore máx (°)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etOffshoreMax" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:id="@+id/tvOffshoreHint"
                    android:textSize="11sp" android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cómo funciona la alerta -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="ℹ️ Cómo funciona" android:textStyle="bold" android:textSize="14sp"
                    android:layout_marginBottom="8dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.4"
                    android:text="La app solo te notifica cuando SE CUMPLEN TODOS los criterios que tengas activados al mismo tiempo:\n\n• Altura de ola ≥ mínimo (y ≤ máximo si lo defines)\n• Período ≥ mínimo configurado\n• Swell ≥ mínimo (si está activado)\n• Swell viene del sector correcto (si está activado)\n• Viento ≤ velocidad máxima\n• Viento sopla en dirección offshore (si está activado)\n\nSi no quieres filtrar por algún criterio, desactiva su switch o deja el valor en 0."/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="💾 Guardar"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
