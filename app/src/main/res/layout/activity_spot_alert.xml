<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">

        <!-- Activar alerta -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Activar alerta para este spot"
                    android:textStyle="bold" android:textSize="15sp"/>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchEnabled" android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Olas -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="🌊 Olas" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginEnd="4dp" android:hint="Altura mín (m)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWaveMin" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="numberDecimal"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="4dp" android:hint="Altura máx (m) 0=∞">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWaveMax" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="numberDecimal"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:hint="Período mín (s)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWavePeriod" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberDecimal"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Swell -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="↗ Swell" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="Swell mín (m)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSwellMin" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberDecimal"/>
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Filtrar dirección swell"/>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSwellDir" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginEnd="4dp" android:hint="Swell dir. mín (°)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSwellDirMin" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="4dp" android:hint="Swell dir. máx (°)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSwellDirMax" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Viento -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="💨 Viento" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="Velocidad máx (km/h)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWindMax" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberDecimal"/>
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Filtrar dirección offshore"/>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchWindDir" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginEnd="4dp" android:hint="Offshore mín (°)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etOffshoreMin" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="4dp" android:hint="Offshore máx (°)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etOffshoreMax" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="💾 Guardar"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
